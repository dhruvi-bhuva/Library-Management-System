# =============================================================================
# Razorpay Test Mode Configuration (College Demo)
# =============================================================================
# 1. Login to https://dashboard.razorpay.com/
# 2. Ensure the top toggle is set to "Test Mode" (NOT Live Mode!)
# 3. Navigate to: Account & Settings -> API Keys -> Generate Key
# 4. Copy your Test Key ID and Key Secret into a local .env file
# 5. Never commit your actual .env file to Git!
# =============================================================================

RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE
